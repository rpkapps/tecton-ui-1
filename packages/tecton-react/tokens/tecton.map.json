    "dataSource": "generated-css-export",
    "nameReconstructed": false,
    "note": "src/styles/tecton-tokens.css is the generated CSS export of the Tecton design system (light + dark). Every shadcn variable references a Tecton token in both modes; `light` defaults to the same token as `dark`."
  },
