/** A Tecton icon: the `slug` of an entry in packages/tecton-react/icons/icons.json. */
export type TectonIconName = (typeof ICONS)[keyof typeof ICONS]

/** Upstream identifier → the Tecton icon that replaces it. */
export const UPSTREAM_ICONS: Record<string, TectonIconName> = ICONS

/** Every Tecton icon this table names, for a manifest cross-check. */
export const TECTON_ICON_NAMES: readonly TectonIconName[] = [
  ...new Set(Object.values(ICONS)),
].sort() as TectonIconName[]

/**
 * `close` → `CloseIcon`: the identifier `@tecton/react/icons` exports for a
 * slug. Every manifest entry's `label` is exactly this, which
 * `verifyAgainstManifest()` re-checks.
 */
export function tectonIconExport(name: TectonIconName): string {
  return (
    name
      .split(/[-_\s]+/)
      .filter(Boolean)
      .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
      .join("") + "Icon"
  )
}

/** The Tecton icon for an upstream identifier, or a hard failure naming it. */
export function tectonIconFor(identifier: string, where: string): TectonIconName {
  const name = UPSTREAM_ICONS[identifier]
  if (!name) {
    throw new Error(
      `${where}: no Tecton icon for the upstream identifier "${identifier}" — ` +
        "add it to scripts/upstream-icons.mts (the catalogue is packages/tecton-react/icons/icons.json)",
    )
  }
  return name
}

/** The `@tecton/react/icons` export for an upstream identifier. */
export function tectonIconImportFor(identifier: string, where: string): string {
  return tectonIconExport(tectonIconFor(identifier, where))
}

/**
 * Check every value against `packages/tecton-react/icons/icons.json` (parsed by
 * the caller, which is the side that can reach the file): a slug that has been
 * renamed or removed shows up here rather than as a missing export at build
 * time.
 */
export function verifyAgainstManifest(
  manifest: { icons: Array<{ slug: string; label: string }> },
  where: string,
): void {
  const labels = new Map(manifest.icons.map((icon) => [icon.slug, icon.label]))
  const problems: string[] = []
  for (const name of TECTON_ICON_NAMES) {
    const label = labels.get(name)
    if (!label) problems.push(`"${name}" is not an icon in icons/icons.json`)
    else if (label !== tectonIconExport(name)) {
      problems.push(`"${name}" is exported as ${label}, not ${tectonIconExport(name)}`)
    }
  }
  if (problems.length) {
    throw new Error(`${where}: scripts/upstream-icons.mts is out of date:\n  ${problems.join("\n  ")}`)
  }
}
