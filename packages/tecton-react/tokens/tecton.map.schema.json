{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tecton → shadcn token map",
  "type": "object",
  "required": ["version", "shadcn", "extra", "theme", "light"],
  "properties": {
    "version": { "type": "integer" },
    "meta": { "type": "object" },
    "shadcn": { "$ref": "#/$defs/mappings" },
    "extra": { "$ref": "#/$defs/mappings" },
    "theme": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "light": {
      "type": "object",
      "required": ["strategy"],
      "properties": {
        "strategy": { "type": "string" },
        "note": { "type": "string" },
        "overrides": { "type": "object", "additionalProperties": { "type": "string" } },
        "overrideNotes": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "palette": {
      "type": "object",
      "required": ["source", "families"],
      "properties": {
        "source": { "type": "string", "description": "Figma variables export (DTCG JSON) next to this file; `foundational/color` holds the ramps." },
        "note": { "type": "string" },
        "prefix": { "type": "string", "description": "CSS variable prefix for the raw ramp values (default `tecton-palette`)." },
        "resetTailwind": { "type": "boolean", "description": "Emit `--color-*: initial` before the palette so Tailwind's stock colours disappear (default true)." },
        "shades": { "type": "array", "items": { "type": "string" }, "description": "Keys of `foundational/color/shades` exposed as `--color-<shade>` (white, black)." },
        "families": { "type": "array", "items": { "type": "string" }, "description": "Keys of `foundational/color` exposed as `--color-<family>-<step>`, in documentation order. Camel case becomes kebab case." }
      }
    },
    "checks": {
      "type": "object",
      "properties": {
        "allow": { "type": "array", "items": { "type": "string" }, "description": "Checks that are expected to fail: a contrast pair (`a/b`) or `palette:<--tecton-color-token>` for a semantic colour that is not a ramp member." },
        "allowNotes": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "required": ["dark", "confidence"],
      "properties": {
        "dark": { "type": "string", "pattern": "^--tecton-" , "description": "Tecton token used in dark mode (and in light mode unless `light` is set)." },
        "light": { "type": "string", "description": "Tecton token (`--tecton-…`), literal CSS value, or \"derived\" (OKLCH lightness inversion of the dark value)." },
        "confidence": { "enum": ["exact", "approximated", "derived"] },
        "note": { "type": "string" }
      }
    },
    "mappings": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/mapping" }
    }
  }
}
