{
  "name": "@tecton/react",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "private": true,
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tokens:build": "bun run scripts/tokens-build.mts",
    "tokens:check": "bun run scripts/tokens-check.mts",
    "icons:build": "bun run scripts/build-icons.mts",
    "icons:extract": "bun run scripts/extract-icons.mts",
    "registry:build": "bun run scripts/registry-build.mts",
    "registry:validate": "shadcn registry validate registry.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/figtree": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.45.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-aria": "3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tanstack/eslint-config": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/culori": "^4.0.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "culori": "^4.0.2",
    "eslint": "^9",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.0"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./styles/*": "./src/styles/*",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./tecton/*": "./src/tecton/*.tsx",
    "./icons": "./src/icons/index.ts",
    "./icons/lucide-compat": "./src/icons/lucide-compat.ts",
    "./icons/*": "./src/icons/*.tsx",
    "./blocks/*": "./src/blocks/*"
  },
  "description": "Tecton design system for React — shadcn/ui (React Aria base) components themed through Tecton tokens, plus Tecton-specific components, icons and blocks.",
  "files": [
    "src",
    "icons/icons.json",
    "tokens",
    "registry/theme.json",
    "registry.json",
    "components.json",
    "icons-src"
  ]
}
