/**
 * build-icons — generates `src/icons/` from the icon manifest + SVG sources.
 *
 *   bun run scripts/build-icons.mts          (pnpm icons:build)
 *
 * Inputs
 *   icons/icons.json               manifest: name / slug / label / lucide / domain
 *   icons-src/tecton/<slug>.ts     the Tecton icon export (defineTectonSvgIcon
 *                                  definitions with outline + filled markup) — primary source
 *   icons-src/<variant>/<slug>.svg loose SVG overrides (see scripts/extract-icons.mts)
 *   src/components/*.tsx           scanned for `from "lucide-react"` identifiers
 *   src/tecton/*.tsx               (same — used to build the lucide compat map)
 *   src/blocks/<name>/...          (same, recursively)
 *
 * Outputs (all GENERATED, all overwritten on every run)
 *   src/icons/<slug>.tsx           one component per manifest icon
 *   src/icons/types.ts             TectonIconProps & friends
 *   src/icons/_runtime.ts          tiny shared helper (size / stroke-width maths)
 *   src/icons/index.ts             named exports + `tectonIcons` gallery array
 *   src/icons/lucide-compat.map.ts lucide identifier → Tecton override / pass-through
 *
 * Per icon, the rendered source is chosen in this order:
 *   1. "svg"              icons-src/tecton/<slug>.ts defines it, or
 *                         icons-src/<variant>/<slug>.svg exists (the other
 *                         variant falls back to whichever variant exists)
 *   2. "lucide-fallback"  manifest `lucide` names a lucide-react export
 *   3. "placeholder"      dashed rounded square (domain glyphs with no peer)
 *
 * Every generated svg carries `data-tecton-icon="<slug>"` and
 * `data-tecton-source="svg" | "lucide-fallback" | "placeholder"` so a docs
 * gallery (or a test) can tell real glyphs from stand-ins.
 *
 * Flags
 *   --check   exit 1 if any output would change (CI drift guard); writes nothing
 */
/// <reference types="node" />
import { existsSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from "node:fs";
import path from "node:path";
import {
  ICONS_OUT_DIR,
  ICONS_SRC_DIR,
  ICON_VARIANTS,
  type IconManifestEntry,
  type IconVariant,
  kebabToPascal,
  loadManifest,
  normalizeSvg,
  parseAttributes,
  pkgRoot,
  scanIconSources,
} from "./icon-utils.mjs";
import type { TectonSvgIcon } from "../icons-src/icon-definition";

const TECTON_DEFINITIONS_DIR = path.join(pkgRoot, "icons-src/tecton");

const HEADER = "// GENERATED by scripts/build-icons.mts — do not edit\n";
const CHECK_MODE = process.argv.includes("--check");
const LUCIDE_DTS = path.join(pkgRoot, "node_modules/lucide-react/dist/lucide-react.d.ts");
/** Folders scanned (recursively) for lucide-react imports when building the compat map. */
const COMPAT_SCAN_DIRS = ["src/components", "src/tecton", "src/blocks"];

type Source = "svg" | "lucide-fallback" | "placeholder";

// ---------------------------------------------------------------------------
// lucide-react export table (parsed from the bundled .d.ts)
// ---------------------------------------------------------------------------
interface LucideExports {
  /** Value exports that are icon components (e.g. `CirclePlus`, `CirclePlusIcon`). */
  values: Set<string>;
  /** Type-only exports (e.g. `LucideIcon`, `LucideProps`). */
  types: Set<string>;
  /** Exported alias → the declared const it points at (`MoreVerticalIcon` → `EllipsisVertical`). */
  canonical: Map<string, string>;
  /** Declared const → every export name that resolves to it (itself included). */
  aliases: Map<string, string[]>;
}

function loadLucideExports(): LucideExports | null {
  if (!existsSync(LUCIDE_DTS)) {
    console.warn(`warning: ${path.relative(pkgRoot, LUCIDE_DTS)} not found — skipping lucide name validation`);
    return null;
  }
  const dts = readFileSync(LUCIDE_DTS, "utf8");
  const values = new Set<string>();
  const types = new Set<string>();
  const canonical = new Map<string, string>();

  // `declare const CirclePlus: LucideIcon;`  and friends (createLucideIcon, Icon, …)
  for (const m of dts.matchAll(/^declare (?:const|function|class) (\w+)/gm)) values.add(m[1]);
  // `type LucideIcon = …` / `interface LucideProps …`
  for (const m of dts.matchAll(/^(?:declare )?(?:type|interface) (\w+)\b/gm)) types.add(m[1]);
  // The final `export { index_CirclePlus as CirclePlus, … }` block: aliases such as
  // `CirclePlusIcon` / `LucideCirclePlus` map to declared consts.
  for (const m of dts.matchAll(/\b(?:index_)?(\w+) as (\w+)/g)) {
    const [, target, alias] = m;
    if (values.has(target)) {
      values.add(alias);
      canonical.set(alias, canonical.get(target) ?? target);
    } else if (types.has(target)) types.add(alias);
  }
  const aliases = new Map<string, string[]>();
  for (const value of values) {
    const root = canonical.get(value) ?? value;
    aliases.set(root, [...(aliases.get(root) ?? []), value]);
  }
  return { values, types, canonical, aliases };
}

/** Closest lucide export names for an unknown one — makes manifest typos easy to fix. */
function suggestLucide(name: string, exports: LucideExports): string[] {
  const needle = name.toLowerCase().replace(/[^a-z0-9]/g, "");
  const out: string[] = [];
  for (const value of exports.values) {
    if (/^(Lucide|index_)/.test(value) || value.endsWith("Icon")) continue;
    const hay = value.toLowerCase();
    if (hay.includes(needle) || needle.includes(hay)) out.push(value);
    if (out.length >= 5) break;
  }
  return out;
}

// ---------------------------------------------------------------------------
// SVG → JSX
// ---------------------------------------------------------------------------

/** Attribute names React wants in a different spelling than SVG. */
const JSX_ATTR_RENAMES: Record<string, string> = {
  class: "className",
  for: "htmlFor",
  "xlink:href": "xlinkHref",
  "xlink:actuate": "xlinkActuate",
  "xlink:arcrole": "xlinkArcrole",
  "xlink:role": "xlinkRole",
  "xlink:show": "xlinkShow",
  "xlink:title": "xlinkTitle",
  "xlink:type": "xlinkType",
  "xml:base": "xmlBase",
  "xml:lang": "xmlLang",
  "xml:space": "xmlSpace",
  "xmlns:xlink": "xmlnsXlink",
  tabindex: "tabIndex",
  viewbox: "viewBox",
};

function toJsxAttrName(name: string): string {
  if (JSX_ATTR_RENAMES[name]) return JSX_ATTR_RENAMES[name];
  if (name.startsWith("data-") || name.startsWith("aria-")) return name;
  // stroke-width → strokeWidth, fill-rule → fillRule, …
  return name.replace(/-([a-z])/g, (_m, c: string) => c.toUpperCase());
}

/** `style="fill:none;stroke-width:2"` → `{{ fill: "none", strokeWidth: "2" }}` */
function styleToJsx(style: string): string {
  const pairs = style
    .split(";")
    .map((s) => s.trim())
    .filter(Boolean)
    .map((decl) => {
      const idx = decl.indexOf(":");
      const prop = decl.slice(0, idx).trim();
      const value = decl.slice(idx + 1).trim();
      const key = prop.startsWith("--") ? JSON.stringify(prop) : prop.replace(/-([a-z])/g, (_m, c: string) => c.toUpperCase());
      return `${key}: ${JSON.stringify(value)}`;
    });
  return `{{ ${pairs.join(", ")} }}`;
}

/** Decode the handful of entities an SVG text node can carry; JSX `{"…"}` expressions are not entity-aware. */
function decodeEntities(text: string): string {
  return text
    .replace(/&#x([0-9a-f]+);/gi, (_m, hex: string) => String.fromCodePoint(parseInt(hex, 16)))
    .replace(/&#(\d+);/g, (_m, dec: string) => String.fromCodePoint(parseInt(dec, 10)))
    .replace(/&(amp|lt|gt|quot|apos|nbsp);/g, (_m, name: string) => ({ amp: "&", lt: "<", gt: ">", quot: '"', apos: "'", nbsp: "\u00a0" })[name] ?? _m);
}

function attrsToJsx(attrs: Map<string, string>): string {
  let out = "";
  for (const [name, value] of attrs) {
    const jsxName = toJsxAttrName(name);
    out += jsxName === "style" ? ` style=${styleToJsx(value)}` : ` ${jsxName}=${JSON.stringify(value)}`;
  }
  return out;
}

interface ParsedSvg {
  /** Root `<svg>` attributes minus xmlns/viewBox (already handled). */
  rootAttrs: Map<string, string>;
  viewBox: string;
  /** Children as JSX source, one element per line, no indentation. */
  childrenJsx: string[];
}

/**
 * Turn a canonical SVG (as written by normalizeSvg) into JSX lines.
 * The tokenizer understands opening / closing / self-closing tags and text
 * (needed for `<text>` glyphs); comments and prolog were already stripped.
 */
function parseSvgForJsx(svg: string, file: string): ParsedSvg {
  const rootMatch = svg.trim().match(/^<svg\b([^>]*)>([\s\S]*)<\/svg>\s*$/i);
  if (!rootMatch) throw new Error(`${file}: not a single <svg> element (run extract-icons to normalise it)`);
  const rootAttrs = parseAttributes(rootMatch[1]);
  const viewBox = rootAttrs.get("viewBox") ?? "0 0 24 24";
  rootAttrs.delete("viewBox");
  rootAttrs.delete("xmlns");

  const lines: string[] = [];
  const stack: string[] = [];
  const tokenRe = /<\/([\w:-]+)\s*>|<([\w:-]+)\b([^>]*?)(\/?)>|([^<]+)/g;
  for (const m of rootMatch[2].matchAll(tokenRe)) {
    const [, closeTag, openTag, attrText, selfClose, text] = m;
    const indent = "  ".repeat(stack.length);
    if (closeTag) {
      const expected = stack.pop();
      if (expected !== closeTag) throw new Error(`${file}: mismatched </${closeTag}> (expected </${expected}>)`);
      lines.push(`${indent.slice(2)}</${closeTag}>`);
    } else if (openTag) {
      const attrs = parseAttributes(attrText);
      // Namespace declarations on descendants (e.g. the XHTML <div> Figma puts
      // inside <foreignObject>) are not valid JSX props; React needs none.
      attrs.delete("xmlns");
      lines.push(`${indent}<${openTag}${attrsToJsx(attrs)}${selfClose ? " />" : ">"}`);
      if (!selfClose) stack.push(openTag);
    } else if (text && text.trim()) {
      // JSX text: escape braces and keep it on its own line
      lines.push(`${indent}{${JSON.stringify(decodeEntities(text.trim()))}}`);
    }
  }
  if (stack.length) throw new Error(`${file}: unclosed <${stack[stack.length - 1]}>`);
  return { rootAttrs, viewBox, childrenJsx: lines };
}

// ---------------------------------------------------------------------------
// Code generation
// ---------------------------------------------------------------------------
interface IconBuild {
  entry: IconManifestEntry;
  /** Component identifier, e.g. `AddCircleIcon`. */
  ident: string;
  /** What each variant renders. */
  sources: Record<IconVariant, Source>;
  /** Primary source (outlined) — what `tectonIcons[].source` reports. */
  source: Source;
  /** lucide-react export used for the fallback, when any. */
  lucideExport: string | null;
  code: string;
}

function indentBlock(lines: string[], depth: number): string {
  const pad = "  ".repeat(depth);
  return lines.map((l) => (l ? pad + l : l)).join("\n");
}

function rootAttrsLiteral(attrs: Map<string, string>): string {
  if (!attrs.size) return "{}";
  const pairs: string[] = [];
  for (const [name, value] of attrs) {
    const key = toJsxAttrName(name);
    const safeKey = /^[A-Za-z_$][\w$]*$/.test(key) ? key : JSON.stringify(key);
    pairs.push(`${safeKey}: ${key === "style" ? styleToJsx(value).slice(1, -1) : JSON.stringify(value)}`);
  }
  return `{ ${pairs.join(", ")} }`;
}

/** One variant's normalised SVG plus where it came from (for the header comment). */
interface SvgSource {
  svg: string;
  origin: string;
}

/**
 * Turn a Tecton export definition into normalised `<svg>` strings per variant.
 * Figma's conic-gradient hack (`<foreignObject>` + `data-figma-*` attributes)
 * is dropped: the clipPath-referenced `<path>` keeps the shape, and the
 * gradient is re-expressed as an SVG `<linearGradient>` fill on that path.
 */
function definitionToSources(def: TectonSvgIcon, origin: string): Record<IconVariant, SvgSource | undefined> {
  const clean = (markup: string) => {
    // Figma exports conic gradients as a <foreignObject> with a CSS gradient
    // inside a clip-path group. Browsers render it, so multi-colour glyphs keep
    // it; monochrome glyphs drop it (the clipped <path> already draws the shape).
    const withoutGradientHack = def.colored
      ? markup
      : markup.replace(/<g[^>]*data-figma-skip-parse="true"[^>]*>[\s\S]*?<\/g>\s*<\/g>/g, "");
    return withoutGradientHack.replace(/\s+data-figma-[\w-]+="(?:[^"\\]|\\.)*"/g, "");
  };
  // The export's paths carry no fill: they inherit from the root, so the root
  // fills with currentColor (the same contract as lucide's stroke="currentColor").
  const wrap = (inner: string) =>
    normalizeSvg(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="${def.viewBox}" fill="currentColor">${clean(inner)}</svg>`, {
      keepColors: def.colored,
    });
  return {
    outlined: def.outline ? { svg: wrap(def.outline), origin: `${origin} (outline)` } : undefined,
    filled: def.filled ? { svg: wrap(def.filled), origin: `${origin} (filled)` } : undefined,
  };
}

/** Load every `icons-src/tecton/<slug>.ts` definition (bun/tsx can import TS directly). */
async function loadTectonDefinitions(): Promise<Map<string, { def: TectonSvgIcon; file: string }>> {
  const out = new Map<string, { def: TectonSvgIcon; file: string }>();
  if (!existsSync(TECTON_DEFINITIONS_DIR)) return out;
  for (const name of readdirSync(TECTON_DEFINITIONS_DIR).sort()) {
    if (!/\.ts$/.test(name) || name === "index.ts") continue;
    const file = path.join(TECTON_DEFINITIONS_DIR, name);
    const mod = (await import(file)) as Record<string, unknown>;
    const def = Object.values(mod).find(
      (v): v is TectonSvgIcon => typeof v === "object" && v !== null && "slug" in v && "viewBox" in v,
    );
    if (!def) throw new Error(`${path.relative(pkgRoot, file)}: no defineTectonSvgIcon() export found`);
    if (out.has(def.slug)) throw new Error(`duplicate Tecton icon definition for "${def.slug}"`);
    out.set(def.slug, { def, file });
  }
  return out;
}

function genSvgComponent(entry: IconManifestEntry, ident: string, sources: Record<IconVariant, SvgSource | undefined>): string {
  // Resolve each variant to a parsed SVG, falling back to the other variant.
  const parsed: Partial<Record<IconVariant, ParsedSvg>> = {};
  for (const variant of ICON_VARIANTS) {
    const src = sources[variant];
    if (src) parsed[variant] = parseSvgForJsx(src.svg, src.origin);
  }
  const outlined = parsed.outlined ?? parsed.filled!;
  const filled = parsed.filled ?? parsed.outlined!;
  const sameGlyph =
    parsed.outlined === undefined ||
    parsed.filled === undefined ||
    parsed.outlined.childrenJsx.join("\n") === parsed.filled.childrenJsx.join("\n");

  // The source's own stroke-width is the default for the `strokeWidth` prop;
  // it is applied through tectonSvgAttrs(), so keep it out of ROOT.
  const strokeWidths: Record<IconVariant, string | undefined> = {
    outlined: outlined.rootAttrs.get("stroke-width"),
    filled: filled.rootAttrs.get("stroke-width"),
  };
  outlined.rootAttrs.delete("stroke-width");
  filled.rootAttrs.delete("stroke-width");

  const sourceComment = ICON_VARIANTS.filter((v) => sources[v])
    .map((v) => `//   ${v}: ${sources[v]!.origin}`)
    .join("\n");

  const body = sameGlyph
    ? indentBlock(outlined.childrenJsx, 3)
    : [
        "      {variant === \"filled\" ? (",
        "        <>",
        indentBlock(filled.childrenJsx, 5),
        "        </>",
        "      ) : (",
        "        <>",
        indentBlock(outlined.childrenJsx, 5),
        "        </>",
        "      )}",
      ].join("\n");

  return `${HEADER}// Source SVGs:
${sourceComment}
import type { SVGProps } from "react"
import type { TectonIconProps, TectonIconVariant } from "./types"
import { tectonSvgAttrs } from "./_runtime"

/** Root <svg> presentation attributes from the source files, per variant. */
const ROOT: Record<TectonIconVariant, SVGProps<SVGSVGElement>> = {
  outlined: ${rootAttrsLiteral(outlined.rootAttrs)},
  filled: ${rootAttrsLiteral(filled.rootAttrs)},
}

const VIEW_BOX: Record<TectonIconVariant, string> = {
  outlined: ${JSON.stringify(outlined.viewBox)},
  filled: ${JSON.stringify(filled.viewBox)},
}

/** The source's own stroke-width — default for the \`strokeWidth\` prop. */
const STROKE_WIDTH: Record<TectonIconVariant, string | undefined> = {
  outlined: ${JSON.stringify(strokeWidths.outlined)},
  filled: ${JSON.stringify(strokeWidths.filled)},
}

/** ${entry.label} — ${entry.description} */
export function ${ident}({
  size = 24,
  strokeWidth,
  absoluteStrokeWidth,
  variant = "outlined",
  className,
  ...props
}: TectonIconProps) {
  return (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox={VIEW_BOX[variant]}
      {...ROOT[variant]}
      {...tectonSvgAttrs(size, strokeWidth ?? STROKE_WIDTH[variant], absoluteStrokeWidth, VIEW_BOX[variant])}
      className={className}
      data-tecton-icon=${JSON.stringify(entry.slug)}
      data-tecton-source="svg"
      data-tecton-variant={variant}
      aria-hidden={props["aria-label"] || props["aria-labelledby"] ? undefined : true}
      {...props}
    >
${body}
    </svg>
  )
}
${ident}.displayName = ${JSON.stringify(ident)}
`;
}

function genLucideFallbackComponent(entry: IconManifestEntry, ident: string, lucideExport: string): string {
  return `${HEADER}// No SVG source yet — renders lucide-react's \`${lucideExport}\` (manifest: lucide: "${entry.lucide}").
// Drop icons-src/outlined/${entry.slug}.svg in place and re-run \`pnpm icons:build\`.
import { ${lucideExport} as Fallback } from "lucide-react"
import type { TectonIconProps } from "./types"

/** ${entry.label} — ${entry.description} */
export function ${ident}({
  size = 24,
  strokeWidth,
  absoluteStrokeWidth,
  variant = "outlined",
  className,
  ...props
}: TectonIconProps) {
  return (
    <Fallback
      size={size}
      strokeWidth={strokeWidth}
      absoluteStrokeWidth={absoluteStrokeWidth}
      className={className}
      data-tecton-icon=${JSON.stringify(entry.slug)}
      data-tecton-source="lucide-fallback"
      data-tecton-variant={variant}
      {...props}
    />
  )
}
${ident}.displayName = ${JSON.stringify(ident)}
`;
}

function genPlaceholderComponent(entry: IconManifestEntry, ident: string): string {
  return `${HEADER}// No SVG source and no lucide equivalent — renders a dashed placeholder.
// Drop icons-src/outlined/${entry.slug}.svg in place and re-run \`pnpm icons:build\`.
import type { TectonIconProps } from "./types"
import { tectonSvgAttrs } from "./_runtime"

/** ${entry.label} — ${entry.description} (placeholder) */
export function ${ident}({
  size = 24,
  strokeWidth = 2,
  absoluteStrokeWidth,
  variant = "outlined",
  className,
  ...props
}: TectonIconProps) {
  return (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeLinecap="round"
      strokeLinejoin="round"
      {...tectonSvgAttrs(size, strokeWidth, absoluteStrokeWidth)}
      className={className}
      data-tecton-icon=${JSON.stringify(entry.slug)}
      data-tecton-source="placeholder"
      data-tecton-variant={variant}
      aria-hidden={props["aria-label"] || props["aria-labelledby"] ? undefined : true}
      {...props}
    >
      <rect x="3" y="3" width="18" height="18" rx="3" strokeDasharray="3 2" />
    </svg>
  )
}
${ident}.displayName = ${JSON.stringify(ident)}
`;
}

const TYPES_TS = `${HEADER}import type { ReactElement, SVGProps } from "react"

export type TectonIconVariant = "outlined" | "filled"

/**
 * Where a rendered icon's glyph comes from:
 *   - \`svg\`              the real Tecton glyph from icons-src/
 *   - \`lucide-fallback\`  the closest lucide-react icon (no Tecton SVG yet)
 *   - \`placeholder\`      dashed square (no Tecton SVG, no lucide peer)
 */
export type TectonIconSource = "svg" | "lucide-fallback" | "placeholder"

/**
 * lucide-compatible icon props. Every Tecton icon is a plain function
 * component (React 19 forwards \`ref\` as a prop, so no forwardRef needed).
 */
export interface TectonIconProps extends SVGProps<SVGSVGElement> {
  /** Width and height (default 24). */
  size?: number | string
  /** Stroke width for stroke-based glyphs; defaults to the glyph's own. */
  strokeWidth?: number | string
  /** Keep the stroke visually constant when \`size\` changes (lucide semantics). */
  absoluteStrokeWidth?: boolean
  /** Glyph style (default \`outlined\`). */
  variant?: TectonIconVariant
}

export type TectonIconComponent = ((props: TectonIconProps) => ReactElement) & { displayName?: string }

/** One row of the \`tectonIcons\` gallery array. */
export interface TectonIconEntry {
  /** PascalCase name without suffix, e.g. \`AddCircle\`. */
  name: string
  /** Exported identifier / gallery label, e.g. \`AddCircleIcon\`. */
  label: string
  /** kebab-case id; also the \`data-tecton-icon\` value and the file name. */
  slug: string
  description: string
  Icon: TectonIconComponent
  /** Source of the default (outlined) variant. */
  source: TectonIconSource
  /** Source per variant (a missing variant falls back to the other one). */
  sources: Record<TectonIconVariant, TectonIconSource>
  /** Oil & gas / subsurface domain glyph. */
  domain: boolean
  /** Closest lucide-react icon (kebab-case lucide name) or null. */
  lucide: string | null
}
`;

const RUNTIME_TS = `${HEADER}/**
 * Size / stroke-width maths shared by generated SVG-backed icons.
 * Mirrors lucide: with \`absoluteStrokeWidth\` the stroke stays visually
 * constant across sizes (strokeWidth * viewBoxSize / size).
 */
export function tectonSvgAttrs(
  size: number | string,
  strokeWidth: number | string | undefined,
  absoluteStrokeWidth: boolean | undefined,
  viewBox = "0 0 24 24",
): { width: number | string; height: number | string; strokeWidth?: number | string } {
  const attrs: { width: number | string; height: number | string; strokeWidth?: number | string } = {
    width: size,
    height: size,
  }
  if (strokeWidth === undefined) return attrs
  const numericSize = typeof size === "number" ? size : Number.parseFloat(size)
  const viewBoxSize = Number.parseFloat(viewBox.split(/\\s+/)[2] ?? "24") || 24
  attrs.strokeWidth =
    absoluteStrokeWidth && Number.isFinite(numericSize) && numericSize > 0
      ? (Number(strokeWidth) * viewBoxSize) / numericSize
      : strokeWidth
  return attrs
}
`;

function genIndex(builds: IconBuild[]): string {
  const exports = builds.map((b) => `export { ${b.ident} } from "./${b.entry.slug}"`).join("\n");
  const imports = builds.map((b) => `import { ${b.ident} } from "./${b.entry.slug}"`).join("\n");
  const rows = builds
    .map((b) => {
      const e = b.entry;
      return `  { name: ${JSON.stringify(e.name)}, label: ${JSON.stringify(e.label)}, slug: ${JSON.stringify(e.slug)}, description: ${JSON.stringify(e.description)}, Icon: ${b.ident}, source: ${JSON.stringify(b.source)}, sources: ${JSON.stringify(b.sources)}, domain: ${e.domain}, lucide: ${JSON.stringify(e.lucide)} },`;
    })
    .join("\n");
  return `${HEADER}import type { TectonIconEntry } from "./types"
${imports}

export type { TectonIconComponent, TectonIconEntry, TectonIconProps, TectonIconSource, TectonIconVariant } from "./types"

${exports}

/** Every Tecton icon, in manifest (alphabetical) order — drives the docs gallery. */
export const tectonIcons: readonly TectonIconEntry[] = [
${rows}
]

/** Lookup by slug, e.g. \`tectonIconsBySlug["add-circle"]\`. */
export const tectonIconsBySlug: Readonly<Record<string, TectonIconEntry>> = Object.fromEntries(
  tectonIcons.map((entry) => [entry.slug, entry]),
)
`;
}

// ---------------------------------------------------------------------------
// lucide compat map
// ---------------------------------------------------------------------------

/** Collect `{ A, B as C }` identifiers imported from "lucide-react" in the scanned dirs. */
function collectLucideIdentifiers(): Map<string, string[]> {
  const uses = new Map<string, string[]>(); // identifier → files
  const visit = (dir: string, rel: string) => {
    for (const entry of readdirSync(dir, { withFileTypes: true })) {
      if (entry.isDirectory()) {
        visit(path.join(dir, entry.name), `${rel}/${entry.name}`);
        continue;
      }
      if (!/\.tsx?$/.test(entry.name)) continue;
      const src = readFileSync(path.join(dir, entry.name), "utf8");
      for (const m of src.matchAll(/import\s+(type\s+)?\{([^}]*)\}\s*from\s*["']lucide-react["']/g)) {
        for (const spec of m[2].split(",")) {
          const cleaned = spec.replace(/\btype\s+/, "").trim();
          if (!cleaned) continue;
          const original = cleaned.split(/\s+as\s+/)[0].trim();
          const files = uses.get(original) ?? [];
          files.push(`${rel}/${entry.name}`);
          uses.set(original, files);
        }
      }
    }
  };
  for (const rel of COMPAT_SCAN_DIRS) {
    const dir = path.join(pkgRoot, rel);
    if (existsSync(dir)) visit(dir, rel);
  }
  return new Map([...uses.entries()].sort(([a], [b]) => a.localeCompare(b)));
}

interface CompatRow {
  ident: string;
  kind: "type" | "lucide" | "tecton";
  /** Tecton build providing the override, when kind === "tecton". */
  build?: IconBuild;
  files: string[];
}

function resolveCompat(uses: Map<string, string[]>, builds: IconBuild[], lucide: LucideExports | null): CompatRow[] {
  // Tecton icons with a real SVG, keyed by the PascalCase lucide name they stand in for.
  const byLucide = new Map<string, IconBuild[]>();
  for (const b of builds) {
    if (b.source !== "svg" || !b.entry.lucide) continue;
    const key = kebabToPascal(b.entry.lucide);
    byLucide.set(key, [...(byLucide.get(key) ?? []), b]);
  }

  // ChevronDownIcon / LucideChevronDown / MoreVerticalIcon → ChevronDown / EllipsisVertical
  const baseOf = (ident: string) => {
    const bare = ident.replace(/^Lucide/, "").replace(/Icon$/, "");
    return lucide?.canonical.get(ident) ?? lucide?.canonical.get(bare) ?? bare;
  };
  const overrideFor = (ident: string): IconBuild | undefined => {
    const candidates = byLucide.get(baseOf(ident)) ?? [];
    // Prefer the icon whose own name equals the lucide name (chevron-down over chevron-down-small).
    return candidates.find((b) => b.entry.slug === b.entry.lucide) ?? candidates[0];
  };

  const rows: CompatRow[] = [];
  const seen = new Set<string>();
  for (const [ident, files] of uses) {
    seen.add(ident);
    if (lucide?.types.has(ident)) {
      rows.push({ ident, kind: "type", files });
      continue;
    }
    if (lucide && !lucide.values.has(ident)) {
      throw new Error(`"${ident}" is imported from lucide-react in ${files.join(", ")} but lucide-react does not export it`);
    }
    const pick = overrideFor(ident);
    rows.push(pick ? { ident, kind: "tecton", build: pick, files } : { ident, kind: "lucide", files });
  }

  // The rest of the catalogue: every lucide export name (and alias) that a
  // Tecton SVG stands in for, so application code importing other lucide
  // icons also gets the Tecton glyph through the bundler alias.
  if (lucide) {
    for (const [base, candidates] of byLucide) {
      const pick = candidates.find((b) => b.entry.slug === b.entry.lucide) ?? candidates[0];
      for (const ident of lucide.aliases.get(base) ?? []) {
        if (seen.has(ident) || lucide.types.has(ident)) continue;
        seen.add(ident);
        rows.push({ ident, kind: "tecton", build: pick, files: ["catalogue"] });
      }
    }
  }
  return rows.sort((a, b) => a.ident.localeCompare(b.ident));
}

function genCompatMap(rows: CompatRow[]): string {
  const overrides = rows.filter((r) => r.kind === "tecton");
  const passthrough = rows.filter((r) => r.kind === "lucide");
  const types = rows.filter((r) => r.kind === "type");

  const lines: string[] = [
    HEADER.trimEnd(),
    "//",
    "// lucide-react identifiers used by src/components, src/tecton and src/blocks,",
    "// plus every lucide name (and alias) a Tecton SVG stands in for, resolved to",
    "// Tecton glyphs where a real SVG source exists. Consumed by ./lucide-compat.ts.",
    "// Everything else lucide exports passes straight through (star re-export;",
    "// the explicit exports below shadow it).",
    "",
    'export * from "lucide-react"',
    "",
  ];

  lines.push(`// ${overrides.length} Tecton override(s)`);
  for (const r of overrides) {
    const b = r.build!;
    lines.push(`export { ${b.ident}${b.ident === r.ident ? "" : ` as ${r.ident}`} } from "./${b.entry.slug}" // ${r.files.join(", ")}`);
  }
  lines.push("", `// ${passthrough.length} lucide pass-through(s) (no Tecton SVG source yet)`);
  for (const r of passthrough) lines.push(`export { ${r.ident} } from "lucide-react" // ${r.files.join(", ")}`);
  if (types.length) {
    lines.push("", "// type-only re-exports");
    for (const r of types) lines.push(`export type { ${r.ident} } from "lucide-react"`);
  }

  lines.push(
    "",
    "/** Which identifiers are served by Tecton vs lucide — handy for docs / tests. */",
    "export const tectonLucideCompat = {",
    ...rows.filter((r) => r.kind !== "type").map((r) => `  ${r.ident}: ${JSON.stringify(r.kind === "tecton" ? r.build!.entry.slug : "lucide")},`),
    "} as const",
    "",
  );
  return lines.join("\n");
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------
async function main(): Promise<void> {
  const manifest = loadManifest();
  const lucide = loadLucideExports();
  const sources = scanIconSources(ICONS_SRC_DIR);
  const definitions = await loadTectonDefinitions();
  const manifestSlugs = new Set(manifest.icons.map((i) => i.slug));
  for (const slug of definitions.keys()) {
    if (!manifestSlugs.has(slug)) console.warn(`warning: icons-src/tecton/${slug}.ts has no entry in icons/icons.json (ignored)`);
  }

  // Warn about SVGs that no manifest entry claims.
  const slugs = new Set(manifest.icons.map((i) => i.slug));
  for (const variant of ICON_VARIANTS) {
    for (const slug of sources[variant].keys()) {
      if (!slugs.has(slug)) console.warn(`warning: icons-src/${variant}/${slug}.svg has no entry in icons/icons.json (ignored)`);
    }
  }

  // Per-icon builds.
  const builds: IconBuild[] = [];
  const idents = new Set<string>();
  const badLucide: string[] = [];
  for (const entry of manifest.icons) {
    const ident = entry.label;
    if (!/^[A-Z][A-Za-z0-9]*Icon$/.test(ident)) throw new Error(`manifest label "${ident}" is not a valid PascalCase identifier ending in "Icon"`);
    if (idents.has(ident)) throw new Error(`duplicate manifest label "${ident}"`);
    idents.add(ident);

    // Loose SVG files override the export; the export is the default source.
    const definition = definitions.get(entry.slug);
    const fromDefinition = definition
      ? definitionToSources(definition.def, path.relative(pkgRoot, definition.file).split(path.sep).join("/"))
      : { outlined: undefined, filled: undefined };
    const svgSources: Record<IconVariant, SvgSource | undefined> = { outlined: undefined, filled: undefined };
    for (const variant of ICON_VARIANTS) {
      const file = sources[variant].get(entry.slug);
      svgSources[variant] = file
        ? { svg: normalizeSvg(readFileSync(file, "utf8")), origin: path.relative(pkgRoot, file).split(path.sep).join("/") }
        : fromDefinition[variant];
    }
    const hasSvg = Boolean(svgSources.outlined || svgSources.filled);

    let lucideExport: string | null = null;
    if (entry.lucide) {
      lucideExport = kebabToPascal(entry.lucide);
      if (lucide && !lucide.values.has(lucideExport)) {
        badLucide.push(`${entry.slug}: lucide "${entry.lucide}" (${lucideExport}) — try: ${suggestLucide(lucideExport, lucide).join(", ") || "?"}`);
        lucideExport = null;
      }
    }

    let code: string;
    let source: Source;
    if (hasSvg) {
      source = "svg";
      code = genSvgComponent(entry, ident, svgSources);
    } else if (lucideExport) {
      source = "lucide-fallback";
      code = genLucideFallbackComponent(entry, ident, lucideExport);
    } else {
      source = "placeholder";
      code = genPlaceholderComponent(entry, ident);
    }
    builds.push({ entry, ident, source, sources: { outlined: source, filled: source }, lucideExport, code });
  }
  if (badLucide.length) {
    throw new Error(`icons/icons.json references lucide icons that lucide-react does not export:\n  ${badLucide.join("\n  ")}`);
  }

  // Files to write.
  const outputs = new Map<string, string>();
  for (const b of builds) outputs.set(path.join(ICONS_OUT_DIR, `${b.entry.slug}.tsx`), b.code);
  outputs.set(path.join(ICONS_OUT_DIR, "types.ts"), TYPES_TS);
  outputs.set(path.join(ICONS_OUT_DIR, "_runtime.ts"), RUNTIME_TS);
  outputs.set(path.join(ICONS_OUT_DIR, "index.ts"), genIndex(builds));
  const compatRows = resolveCompat(collectLucideIdentifiers(), builds, lucide);
  outputs.set(path.join(ICONS_OUT_DIR, "lucide-compat.map.ts"), genCompatMap(compatRows));

  // Stale generated files (icons removed from the manifest).
  const stale: string[] = [];
  if (existsSync(ICONS_OUT_DIR)) {
    for (const name of readdirSync(ICONS_OUT_DIR)) {
      const file = path.join(ICONS_OUT_DIR, name);
      if (outputs.has(file) || !/\.tsx?$/.test(name)) continue;
      if (readFileSync(file, "utf8").startsWith(HEADER)) stale.push(file);
    }
  }

  // Write (or check).
  let changed = 0;
  for (const [file, content] of outputs) {
    // Windows checkouts may carry CRLF; compare on normalised line endings.
    const current = existsSync(file) ? readFileSync(file, "utf8").replace(/\r\n/g, "\n") : null;
    if (current === content) continue;
    changed++;
    if (CHECK_MODE) console.log(`would ${current === null ? "create" : "update"} ${path.relative(pkgRoot, file)}`);
    else {
      mkdirSync(path.dirname(file), { recursive: true });
      writeFileSync(file, content, "utf8");
    }
  }
  for (const file of stale) {
    changed++;
    if (CHECK_MODE) console.log(`would delete ${path.relative(pkgRoot, file)}`);
    else rmSync(file);
  }

  // Summary.
  const count = (s: Source) => builds.filter((b) => b.source === s).length;
  console.log(
    [
      `icons: ${builds.length} component(s) → ${path.relative(pkgRoot, ICONS_OUT_DIR)}/`,
      `  svg: ${count("svg")}   lucide-fallback: ${count("lucide-fallback")}   placeholder: ${count("placeholder")}`,
      `  lucide compat: ${compatRows.filter((r) => r.kind === "tecton").length} Tecton override(s), ${compatRows.filter((r) => r.kind === "lucide").length} pass-through(s)`,
      `  ${CHECK_MODE ? "changes pending" : "files changed"}: ${changed}${stale.length ? ` (stale removed: ${stale.length})` : ""}`,
    ].join("\n"),
  );
  if (CHECK_MODE && changed) {
    console.error("build-icons --check: outputs are out of date — run `pnpm icons:build`");
    process.exit(1);
  }
}

main().catch((err) => {
  console.error(`build-icons: ${err instanceof Error ? err.message : String(err)}`);
  process.exit(1);
});
