{
  "name": "@tecton/blocks",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write --ignore-path ../../.prettierignore \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "registry:build": "bun run scripts/registry-build.mts",
    "registry:validate": "shadcn registry validate registry.json"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.2.4",
    "@tecton/react": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.45.0",
    "react": "^19.2.6",
    "react-aria-components": "^1.21.1",
    "recharts": "3.8.0"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "jsdom": "^30.0.1",
    "react-dom": "^19.2.6",
    "shadcn": "4.21.0",
    "typescript": "^6",
    "vitest": "^5.0.0"
  },
  "exports": {
    ".": "./src/blocks/index.ts",
    "./*": "./src/blocks/*"
  },
  "description": "Tecton blocks — copy-paste page compositions published through the @tecton shadcn registry; they import the components from @tecton/react."
}
