    "tokens:check": "bun run scripts/tokens-check.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.45.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tanstack/eslint-config": "latest",
    "@turbo/gen": "^2.9.15",
    "@types/culori": "^4.0.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "culori": "^4.0.2",
    "eslint": "^9",
    "tailwindcss": "^4",
    "typescript": "^6"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./styles/*": "./src/styles/*",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./tecton/*": "./src/tecton/*.tsx",
    "./icons": "./src/icons/index.ts",
    "./icons/*": "./src/icons/*.tsx",
    "./blocks/*": "./src/blocks/*"
