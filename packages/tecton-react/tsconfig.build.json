  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "stripInternal": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["src/**/__tests__/**"]
}
